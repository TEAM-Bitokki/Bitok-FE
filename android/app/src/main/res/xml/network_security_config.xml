<?xml version="1.0" encoding="utf-8"?>
<!-- 개발 서버가 HTTPS를 지원하지 않아 해당 호스트만 평문(HTTP) 통신을 허용합니다.
     서버에 도메인 + HTTPS가 붙으면 이 domain-config를 제거하세요. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">13.125.168.145</domain>
    </domain-config>
</network-security-config>
